# Copy to infra/.env to change host ports. All values are optional; these are the defaults.
POSTGRES_PORT=5433
REDIS_PORT=6380
# Full stack (profile "app") is served at http://localhost:${APP_PORT}
APP_PORT=8080
# Optional mail and Google sign-in for the API (see backend/docs/06-domain-guides/auth.md)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Fluctuz <no-reply@fluctuz.id>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
