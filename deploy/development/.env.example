# /opt/fluctuz/.env on the development server (never committed). Created once by hand;
# the deploy workflows never overwrite it. api, worker, scheduler and migrate read the whole file
# (env_file), so any setting from fredd-backend/.env.example can be added here directly.

# --- wiring (required) ---
POSTGRES_PASSWORD=change-me
# Public address of the app. Must match NEXT_PUBLIC_SITE_URL baked into the web image
# (repository variable DEPLOY_SITE_URL in fredd-frontend), or the CSRF check rejects requests.
APP_BASE_URL=http://139.162.58.173:8095
APP_PORT=8095
# development = cookies over plain http; staging once a domain with TLS exists.
# ENVIRONMENT=development

# --- rollback: image tag per service ("development" = latest build, or a commit SHA) ---
# API_TAG=development
# WEB_TAG=development

# --- backend settings (meaning: fredd-backend/.env.example; DATABASE_URL, REDIS_URL and
# MEDIA_DIR are set by the compose file and ignored here) ---
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=Fluctuz <no-reply@fluctuz.id>
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_WEBHOOK_SECRET=
# PRIVACY_POLICY_URL=
# WHATSAPP_PUBLIC_NUMBER=
# STORAGE_ENABLED=true
# STORAGE_ENDPOINT_URL=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
# STORAGE_BUCKET=
# STORAGE_KEY_PREFIX=fluctuz/
# STT_PROVIDER=fake
# LLM_PROVIDER=off
# OPENAI_API_KEY=
# LLM_MODEL=gpt-5.4-mini
